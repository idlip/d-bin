#!/usr/bin/env bash
source d-var.conf

file="$HOME/.todo.org"
touch "$file"
height=$(wc -l "$file" | awk '{print $1}')
prompt="Add/delete a task: "

cmd=$($D_MENU -l "$height" -p "$prompt" "$@" < "$file")
while [ -n "$cmd" ]; do
 	if grep -q "^$cmd\$" "$file"; then
		grep -v "^$cmd\$" "$file" > "$file.$$"
		mv "$file.$$" "$file"
        height=$(( height - 1 ))
 	else
		echo "* TODO $cmd" >> "$file"
		height=$(( height + 1 ))
 	fi

	cmd=$($D_MENU -l "$height" -p "$prompt" "$@" < "$file")
done

exit 0
