#!/usr/bin/env bash
# Path to wallpapers directory
wall_dir=~/d-git/d-wallpapers/walls/

if [ -z "$1" ]; then
	  wall1="$(find "$wall_dir" | shuf -n1)"
    wall2="$(find "$wall_dir" | shuf -n1)"
else
	wall1="$1"
  wall2="$2"
fi

cp "$wall1" ~/.local/share/bg1
cp "$wall2" ~/.local/share/bg2

########### If you use pywal (If not use feh)
#wal -c
#wal -n -i ~/.local/share/bg.jpg
#wal -R
###########################

# For wayland users
pkill swaybg
swaybg -i ~/.local/share/bg1 &
